{
  "name": "@workbuddy/dsh-antigravity-orchestrator",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/bbj32/dsh-model-pairing.git" },
  "type": "module",
  "description": "Plan, execute and review in one DSH conversation with independently selected models.",
  "engines": { "dsh": ">=0.2.2-rc.5 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "adapter.js", "runtime.js", "state.js", "roles.js", "settings.js", "client.js", "client.presentation.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
